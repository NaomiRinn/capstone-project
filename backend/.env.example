# Supabase credentials
# Salin file ini menjadi .env lalu isi nilainya.
# Ambil dari dashboard Supabase → Project Settings → API
#   SUPABASE_URL = Project URL
#   SUPABASE_KEY = service_role key (DISARANKAN untuk backend, bypass RLS)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-key-here

# Nama bucket Supabase Storage untuk gambar scan (default: scans)
STORAGE_BUCKET=scans
